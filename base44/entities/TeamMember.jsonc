{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Full Name"
    },
    "position": {
      "type": "string",
      "title": "Position"
    },
    "bio": {
      "type": "string",
      "title": "Biography"
    },
    "photo_url": {
      "type": "string",
      "title": "Photo URL"
    },
    "order": {
      "type": "number",
      "title": "Display Order",
      "default": 0
    }
  },
  "required": [
    "name",
    "position"
  ]
}